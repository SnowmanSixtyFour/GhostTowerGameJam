; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ghost Tower"
run/main_scene="uid://dqt7ityud2vmb"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SettingsFile="*uid://cpi6wobyd72uj"
PreventTab="*uid://pqk73tbmjblm"
CrtFilter="*uid://bey1w5586mwlw"
TransitionScreen="*uid://cuyteyrc7u8a2"
SceneHandler="*uid://4k6mbne1xbl1"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true

[gui]

